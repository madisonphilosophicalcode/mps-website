# Sanity project (required to fetch content — see sanity.config.ts / lib/sanity/client.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical site URL, used for metadata/sitemap generation (see data/site.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar API key for the meetings calendar (see lib/googleCalendar.ts)
# Without this, the calendar section is hidden rather than erroring.
GOOGLE_CALENDAR_API_KEY=
